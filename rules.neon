parametersSchema:
	typo3DeadCode: structure([
		configurationDirectory: schema(string(), nullable())
		markConstructors: bool()
		markEventApi: bool()
		markFluidAccess: bool()
	])

parameters:
	typo3DeadCode:
		configurationDirectory: null
		markConstructors: true
		markEventApi: false
		markFluidAccess: false

services:
	-
		class: KonradMichalik\PhpStanTypo3DeadCode\Typo3EntrypointProvider
		arguments:
			analysedPaths: %analysedPaths%
			currentWorkingDirectory: %currentWorkingDirectory%
			configurationDirectory: %typo3DeadCode.configurationDirectory%
			markConstructors: %typo3DeadCode.markConstructors%
			markFluidAccess: %typo3DeadCode.markFluidAccess%
		tags:
			- shipmonk.deadCode.memberUsageProvider
	-
		class: KonradMichalik\PhpStanTypo3DeadCode\EventApiProvider
		arguments:
			enabled: %typo3DeadCode.markEventApi%
		tags:
			- shipmonk.deadCode.memberUsageProvider
