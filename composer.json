{
	"name": "konradmichalik/phpstan-typo3-dead-code",
	"description": "TYPO3 entry points for shipmonk/dead-code-detector: DI constructors, route targets and TypoScript userFunc",
	"license": "GPL-3.0-or-later",
	"type": "phpstan-extension",
	"version": "0.2.0",
	"keywords": [
		"php",
		"phpstan",
		"phpstan-extension",
		"typo3",
		"dead-code",
		"static-analysis"
	],
	"authors": [
		{
			"name": "Konrad Michalik",
			"email": "hej@konradmichalik.dev",
			"role": "Maintainer"
		}
	],
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
		"phpstan/phpstan": "^2.1.41",
		"shipmonk/dead-code-detector": "^1.4",
		"symfony/yaml": "^6.4 || ^7.0 || ^8.0"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.0",
		"ergebnis/composer-normalize": "^2.44",
		"konradmichalik/php-cs-fixer-preset": "^0.4.0",
		"phpstan/phpstan-phpunit": "^2.1",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"rector/rector": "^2.9"
	},
	"conflict": {
		"typo3/class-alias-loader": "<1.2.1"
	},
	"autoload": {
		"psr-4": {
			"KonradMichalik\\PhpStanTypo3DeadCode\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"KonradMichalik\\PhpStanTypo3DeadCode\\Tests\\": "tests/src/"
		},
		"classmap": [
			"tests/Fixtures"
		]
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true
		},
		"sort-packages": true
	},
	"extra": {
		"phpstan": {
			"includes": [
				"rules.neon"
			]
		}
	},
	"scripts": {
		"fix": [
			"@fix:composer",
			"@fix:editorconfig",
			"@fix:php"
		],
		"fix:composer": "@composer normalize",
		"fix:editorconfig": "@lint:editorconfig --fix",
		"fix:php": "php-cs-fixer fix",
		"lint": [
			"@lint:composer",
			"@lint:editorconfig",
			"@lint:php"
		],
		"lint:composer": "@fix:composer --dry-run",
		"lint:editorconfig": "ec",
		"lint:php": "@fix:php --dry-run",
		"migration": [
			"@migration:rector"
		],
		"migration:rector": "rector process -c rector.php",
		"sca": [
			"@sca:php"
		],
		"sca:php": "phpstan analyse --memory-limit=2G",
		"test": "@test:coverage --no-coverage",
		"test:coverage": "XDEBUG_MODE=coverage phpunit -c phpunit.xml"
	}
}
